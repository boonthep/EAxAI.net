---
// src/pages/index.astro
// EAxAI.net Static Web Hub - Thai Version
---
<html lang="th">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EAxAI.net - The Turtle Way</title>
  <style>
    /* สไตล์ตกแต่งควบคุมธีมสีเทคโนโลยีการเงิน น้ำเงิน-ทอง-ขาว */
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background-color: #f4f6f9; color: #333; }
    
    /* แถบเมนูด้านบนดึงโลโก้ทางการมาใช้ */
    .nav-container { background-color: #0b1a30; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
    .nav-logo-link { display: flex; align-items: center; text-decoration: none; }
    .nav-logo-img { height: 40px; width: auto; border-radius: 4px; }
    .nav-menu { display: flex; gap: 20px; list-style: none; margin: 0; padding: 0; align-items: center; }
    .nav-menu a { color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 500; transition: 0.3s; }
    .nav-menu a:hover { color: #d4af37; }
    .lang-btn { background: #d4af37; color: #0b1a30 !important; padding: 4px 10px; border-radius: 4px; font-weight: bold; }
    
    /* ส่วนแบนเนอร์หลักควบคุมขนาดพอดีจอ */
    .banner-container { max-width: 1000px; margin: 25px auto 10px auto; padding: 0 20px; text-align: center; }
    .hero-img { width: 100%; height: auto; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
    
    /* ปุ่ม EA-MT5 ไฮเปอร์ลิงก์แจ้งเตือนการทดสอบระบบ */
    .btn-mt5 { display: inline-block; padding: 10px 24px; background: linear-gradient(135deg, #d4af37, #aa7c11); color: #fff; text-decoration: none; border-radius: 6px; font-weight: bold; box-shadow: 0 4px 6px rgba(0,0,0,0.15); transition: 0.3s; margin-top: 10px; cursor: pointer; border: none; font-size: 14px; }
    .btn-mt5:hover { transform: translateY(-2px); box-shadow: 0 6px 12px rgba(0,0,0,0.2); }
    
    /* แผงปุ่มเมนูไอคอน 4 ปุ่มหลัก ถอดดีไซน์โค้งมน มีมิติ สีสันสดใสสไตล์แอปเป๋าตัง */
    .paotang-menu-grid { background-color: #ffffff; padding: 20px 15px; border-radius: 18px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); max-width: 650px; margin: 25px auto; display: flex; justify-content: space-around; text-align: center; }
    .paotang-item { text-decoration: none; color: #444; display: flex; flex-direction: column; align-items: center; width: 22%; transition: 0.2s; }
    .paotang-item:hover { transform: scale(1.05); }
    .icon-box { width: 52px; height: 52px; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; }
    .icon-text { font-size: 12px; font-weight: 600; line-height: 1.3; }
    
    /* ไล่เฉดสีปุ่มไอคอนสไตล์เป๋าตัง */
    .bg-blue { background: linear-gradient(135deg, #1e3c72, #2a5298); box-shadow: 0 4px 8px rgba(30,60,114,0.2); }
    .bg-gold { background: linear-gradient(135deg, #d4af37, #aa7c11); box-shadow: 0 4px 8px rgba(212,175,55,0.2); }
    .bg-cyan { background: linear-gradient(135deg, #00c6ff, #0072ff); box-shadow: 0 4px 8px rgba(0,114,255,0.2); }
    .bg-green { background: linear-gradient(135deg, #11998e, #38ef7d); box-shadow: 0 4px 8px rgba(56,239,125,0.2); }
    .emoji-size { font-size: 22px; color: #fff; }

    main { max-width: 1000px; margin: 30px auto; padding: 0 20px; }
    .section-title { border-bottom: 2px solid #d4af37; padding-bottom: 6px; color: #0b1a30; font-size: 20px; }
  </style>
</head>
<body>

  <!-- 1. แถบเมนูด้านบนดึงภาพโลโก้ทางการมาแสดงผลแทนตัวอักษร -->
  <nav class="nav-container">
    <a href="/" class="nav-logo-link">
      <img src="/images/logo.png" alt="EAxAI Official Logo" class="nav-logo-img" />
    </a>
    <ul class="nav-menu">
      <li><a href="#tools">บริการฟรี</a></li>
      <li><a href="#products">ผลิตภัณฑ์ภายนอก</a></li>
      <li><a href="/en" class="lang-btn">EN</a></li>
    </ul>
  </nav>

  <!-- 2. โซน Hero Banner และปุ่มลิงก์จองระบบ EA-MT5 ตามเป้าหมาย -->
  <div class="banner-container">
    <img src="/images/hero-banner.png" alt="EAxAI Gold Regime Hybrid Banner" class="hero-img" />
    <div>
      <button class="btn-mt5" onclick="alert('ระบบ EA-MT5 Regime อยู่ระหว่างการทดสอบระบบภายใน (Under Testing) จะเปิดให้เชื่อมต่อลิงก์ภายนอกเร็วๆ นี้ครับ');">
        🔗 ไฮเปอร์ลิงก์ระบบ EA-MT5 Regime (Coming Soon)
      </button>
    </div>
  </div>

  <!-- 3. แผงเมนูปุ่มทางลัดสไตล์แอปเป๋าตัง เพิ่มเอกลักษณ์เฉพาะตัวแบบไม่ละเมิดลิขสิทธิ์ -->
  <div class="paotang-menu-grid">
    <a href="#tools" class="paotang-item">
      <div class="icon-box bg-blue"><span class="emoji-size">📊</span></div>
      <span class="icon-text">คำนวณความเสี่ยง</span>
    </a>
    <a href="#tools" class="paotang-item">
      <div class="icon-box bg-gold"><span class="emoji-size">📔</span></div>
      <span class="icon-text">บันทึกเทรด</span>
    </a>
    <a href="#tools" class="paotang-item">
      <div class="icon-box bg-cyan"><span class="emoji-size">🛠️</span></div>
      <span class="icon-text">3 เครื่องมือฟรี</span>
    </a>
    <a href="#products" class="paotang-item">
      <div class="icon-box bg-green"><span class="emoji-size">📦</span></div>
      <span class="icon-text">สินค้าดิจิทัล</span>
    </a>
  </div>

  <!-- 4. ส่วนเนื้อหารองรับวัตถุประสงค์ Static Web Hub -->
  <main id="tools">
    <h2 class="section-title">📌 สถานะระบบจัดทำเว็บไซต์</h2>
    <p style="color: #666; font-size: 14px; line-height: 1.6;">
      ยินดีต้อนรับสู่ระบบ EAxAI.net ศูนย์รวมเครื่องมือเทรดฟรีเพื่อวินัยที่ยั่งยืนตามแนวทาง The Turtle Way ขณะนี้โครงสร้างสไตล์แอปเป๋าตังและระบบจัดวางภาพพื้นฐานเสร็จสมบูรณ์แล้ว พร้อมเข้าสู่กระบวนการใส่ข้อมูลภาษาไทยเต็มรูปแบบในขั้นต่อไป
    </p>
  </main>

</body>
</html>
